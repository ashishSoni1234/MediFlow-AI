# --- Database ---
DATABASE_URL=postgresql://mediflow:mediflow@localhost:5433/mediflow

# --- Groq (LLM) ---
GROQ_API_KEY=
# llama-3.1-8b-instant has a much higher free-tier RPM/TPM allowance than
# the 70b models, and this app's tool-calling loop can make several
# completions per user turn, so the smaller model hits limits far less.
GROQ_MODEL=llama-3.1-8b-instant

# --- MCP Server <-> Agent Service ---
MCP_SERVER_URL=http://localhost:8100/mcp
# Optional: set the same value on both mcp_server and agent_service to
# require Authorization: Bearer <secret> on MCP requests. Leave blank for
# local dev (no auth) — see mcp_server/server.py's _SharedSecretMiddleware.
MCP_SHARED_SECRET=

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google Calendar (OAuth2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Email (Brevo transactional email API — https://app.brevo.com) ---
# SMTP from Render is blocked at the network level (ENETUNREACH), so email
# goes out over Brevo's HTTPS API instead. BREVO_SENDER_EMAIL must be a
# verified sender in your Brevo account (Senders, no domain required).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MediFlow AI

# --- Optional: Slack notification channel for notify_doctor ---
SLACK_WEBHOOK_URL=

# --- Auth (JWT signing secret for /auth/login and /auth/signup) ---
JWT_SECRET=change-me-in-production

# --- Supabase (used only to verify Google sign-in tokens for /auth/google) ---
# Find both in your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
