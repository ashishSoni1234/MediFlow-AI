# --- Database ---
DATABASE_URL=postgresql://mediflow:mediflow@localhost:5433/mediflow

# --- Groq (LLM) ---
GROQ_API_KEY=

# --- MCP Server <-> Agent Service ---
MCP_SERVER_URL=http://localhost:8100/mcp
# Optional: set the same value on both mcp_server and agent_service to
# require Authorization: Bearer <secret> on MCP requests. Leave blank for
# local dev (no auth) — see mcp_server/server.py's _SharedSecretMiddleware.
MCP_SHARED_SECRET=

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google Calendar (OAuth2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Email (Gmail via SMTP App Password, simplest fallback) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# --- Optional: Slack notification channel for notify_doctor ---
SLACK_WEBHOOK_URL=

# --- Auth (JWT signing secret for /auth/login and /auth/signup) ---
JWT_SECRET=change-me-in-production

# --- Supabase (used only to verify Google sign-in tokens for /auth/google) ---
# Find both in your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
